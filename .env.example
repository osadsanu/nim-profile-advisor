# Copy to .env and set a password before `docker compose up`
MONGO_ROOT_USER=nimadmin
MONGO_ROOT_PASSWORD=change-me
MONGO_DB=nim_advisor
MONGO_PORT=27017
WEB_PORT=8080
MONGO_EXPRESS_PORT=8081

# Run the image published by GitHub Actions instead of building it locally
# NIM_ADVISOR_IMAGE=ghcr.io/osadsanu/nim-profile-advisor:latest

# Registry prefix of catalog entries that mirror nvcr.io (folder suffix = last segment, "_ezmeral-common")
# INTERNAL_REGISTRY_PREFIX=registry.example.com/ezmeral-common/
